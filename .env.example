# Published address on the Docker host. Use its LAN IP or 0.0.0.0 for remote access.
MCP_BIND_IP=127.0.0.1
MCP_PORT=8000

# Exact public Host and browser Origin. Include a non-default public port.
# Reverse-proxy example: research.example.com / https://research.example.com
MCP_ALLOWED_HOST=localhost:8000
MCP_ALLOWED_ORIGIN=http://localhost:8000

# Trust forwarded headers only from your proxy's address as seen by the container.
# Needed behind HTTPS proxies for exported download URLs to use HTTPS.
MCP_TRUSTED_PROXIES=127.0.0.1

# Create this host directory before starting. Keep the container path /workspace.
TRADINGDEV_DATA_DIR=./workspace
# Set these to the numeric UID/GID that can write the host directory (id -u / id -g).
TRADINGDEV_UID=1000
TRADINGDEV_GID=1000

# Trusted MCP controller access to the local Docker daemon; never mounted in strategies.
# On Linux use: stat -c '%g' /var/run/docker.sock
TRADINGDEV_DOCKER_SOCKET=/var/run/docker.sock
TRADINGDEV_DOCKER_GID=0
# Build this tag with Dockerfile's strategy-runtime target before starting MCP.
TRADINGDEV_STRATEGY_IMAGE=tradingdev-strategy-runtime:0.1.0
# Optional JSON overrides; omitted fields retain RuntimeLimits defaults.
# TRADINGDEV_RUNTIME_LIMITS={"max_seconds":600,"memory_bytes":4294967296}
