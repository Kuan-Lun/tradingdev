{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "slides: watch",
      "detail": "檢查並補齊鎖定依賴，再於儲存簡報或主題時更新 index.html。",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--all-extras",
        "python",
        "-m",
        "tooling.presentations",
        "watch",
        "--ensure-toolchain"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "focus": false,
        "panel": "dedicated"
      },
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      }
    },
    {
      "label": "slides: build",
      "detail": "檢查並補齊鎖定依賴，再輸出靜態 index.html。",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--all-extras",
        "python",
        "-m",
        "tooling.presentations",
        "build",
        "--ensure-toolchain"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "focus": false,
        "panel": "dedicated"
      },
      "group": "build"
    }
  ]
}
