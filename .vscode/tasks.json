{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "slides: watch",
      "detail": "儲存 TradingDev 簡報或主題時，自動更新 index.html。",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--no-sync",
        "python",
        "-m",
        "tooling.presentations",
        "watch"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "focus": false,
        "panel": "dedicated"
      },
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      }
    },
    {
      "label": "slides: build",
      "detail": "輸出供保存或發布的靜態 index.html。",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--no-sync",
        "python",
        "-m",
        "tooling.presentations",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "focus": false,
        "panel": "dedicated"
      },
      "group": "build"
    }
  ]
}
