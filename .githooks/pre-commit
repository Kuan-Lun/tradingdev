#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
primary="$(scripts/detect-primary-branch.sh)"
if [[ "$(git branch --show-current)" == "$primary" ]]; then
    [[ -f "$(git rev-parse --git-path MERGE_HEAD)" ]] || {
        echo "Direct commits to $primary are not allowed." >&2
        exit 1
    }
    exec "${TRADINGDEV_CHECK_PYTHON:-.venv/bin/python}" scripts/git_gate.py merge
fi
exec "${TRADINGDEV_CHECK_PYTHON:-.venv/bin/python}" scripts/git_gate.py commit
