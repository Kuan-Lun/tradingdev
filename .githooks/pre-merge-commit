#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
primary="$(scripts/detect-primary-branch.sh)"
[[ "$(git branch --show-current)" == "$primary" ]] || {
    echo "Merge commits must be made on $primary." >&2
    exit 1
}
exec "${TRADINGDEV_CHECK_PYTHON:-.venv/bin/python}" scripts/git_gate.py merge
